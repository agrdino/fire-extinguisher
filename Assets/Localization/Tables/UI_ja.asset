    m_Localized: "CO\u2082\u6D88\u706B\u5668\u306F\u6DB2\u4F53\u706B\u707D\u3001\u7C89\u672B\u6D88\u706B\u5668\u306F\u56FA\u4F53\u706B\u707D\u306B\u4F7F\u7528\u3057\u307E\u3059\u30021\u3064\u9078\u3093\u3067\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044\u3002"

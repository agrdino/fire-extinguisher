    m_Localized: "\u6642\u9593\u5185\u306B\u5B89\u5168\u306A\u5834\u6240\u3078\u5230\u9054\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u6B63\u3057\u3044\u6D88\u706B\u624B\u9806\u3067\u518D\u8A66\u884C\u3057\u3066\u304F\u3060\u3055\u3044\u3002"

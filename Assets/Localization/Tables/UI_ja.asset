    m_Metadata:
      m_Items: []
  - m_Id: 1328652289
    m_Localized: "\u78BA\u8A8D"
    m_Metadata:
      m_Items: []
  - m_Id: 1328652290
    m_Localized: "\u7D9A\u3051\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040896
    m_Localized: "\u623B\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040897
    m_Localized: "\u518D\u8A66\u884C"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040898
    m_Localized: "\u518D\u30B9\u30BF\u30FC\u30C8"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040900
    m_Localized: "\u6D88\u706B\u8A13\u7DF4"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040901
    m_Localized: "\u8A13\u7DF4\u3092\u958B\u59CB"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040902
    m_Localized: "1. \u706B\u707D\u306E\u7A2E\u985E\u306B\u5408\u3063\u305F\u6D88\u706B\u5668\u3092\u9078\u3073\u307E\u3059\u3002\n2.
      \u5B89\u5168\u30D4\u30F3\u3092\u629C\u304D\u307E\u3059\u3002\n3. \u30CE\u30BA\u30EB\u3092\u706B\u5143\u306B\u5411\u3051\u307E\u3059\u3002\n4.
      \u30EC\u30D0\u30FC\u3092\u63E1\u308A\u3001\u5DE6\u53F3\u306B\u5674\u5C04\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040903
    m_Localized: "\u5DE5\u5834"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040904
    m_Localized: "\u5DE5\u5834\u3067\u306E\u706B\u707D\u5B89\u5168\u8A13\u7DF4"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040905
    m_Localized: "\u516C\u5712"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040906
    m_Localized: "\u5C4B\u5916\u3067\u306E\u706B\u707D\u5B89\u5168\u8A13\u7DF4"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040907
    m_Localized: "\u8A00\u8A9E\u3092\u9078\u629E"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040908
    m_Localized: "\u4F7F\u7528\u3059\u308B\u8A00\u8A9E\u3092\u9078\u3093\u3067\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040909
    m_Localized: "Ti\u1EBFng Vi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040910
    m_Localized: English
    m_Metadata:
      m_Items: []
  - m_Id: 1337040911
    m_Localized: "\u65E5\u672C\u8A9E"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040912
    m_Localized: "\u5B89\u5168\u30AC\u30A4\u30C9"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040913
    m_Localized: "1. \u5468\u56F2\u3092\u78BA\u8A8D\u3057\u3001\u975E\u5E38\u53E3\u306E\u4F4D\u7F6E\u3092\u628A\u63E1\u3057\u307E\u3059\u3002\n2.
      \u706B\u707D\u306E\u7A2E\u985E\u306B\u5408\u3063\u305F\u6D88\u706B\u5668\u3092\u9078\u3073\u307E\u3059\u3002\n3.
      \u5B89\u5168\u30D4\u30F3\u3092\u629C\u304D\u307E\u3059\u3002\n4. \u30CE\u30BA\u30EB\u3092\u706B\u5143\u306B\u5411\u3051\u307E\u3059\u3002\n5.
      \u30EC\u30D0\u30FC\u3092\u63E1\u308A\u3001\u5DE6\u53F3\u306B\u5674\u5C04\u3057\u307E\u3059\u3002\n6.
      \u6D88\u706B\u5F8C\u3001\u6848\u5185\u8868\u793A\u306B\u5F93\u3063\u3066\u975E\u5E38\u53E3\u3078\u5411\u304B\u3044\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040914
    m_Localized: "\u8A13\u7DF4\u3092\u59CB\u3081\u308B\u524D\u306B\uFF1A\n1. \u5468\u56F2\u3092\u78BA\u8A8D\u3057\u3001\u975E\u5E38\u53E3\u306E\u4F4D\u7F6E\u3092\u628A\u63E1\u3057\u307E\u3059\u3002\n2.
      \u706B\u707D\u304C\u767A\u751F\u3057\u305F\u3089\u3001\u7A2E\u985E\u306B\u5408\u3063\u305F\u6D88\u706B\u5668\u3092\u9078\u3073\u307E\u3059\u3002\n3.
      \u5B89\u5168\u30D4\u30F3\u3092\u629C\u304D\u307E\u3059\u3002\n4. \u30CE\u30BA\u30EB\u3092\u706B\u5143\u306B\u5411\u3051\u307E\u3059\u3002\n5.
      \u30EC\u30D0\u30FC\u3092\u63E1\u308A\u3001\u5DE6\u53F3\u306B\u5674\u5C04\u3057\u307E\u3059\u3002\n6.
      \u6D88\u706B\u5F8C\u3001\u6848\u5185\u8868\u793A\u306B\u5F93\u3063\u3066\u975E\u5E38\u53E3\u3078\u5411\u304B\u3044\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040915
    m_Localized: "\u5468\u56F2\u3092\u78BA\u8A8D"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040916
    m_Localized: "\u5468\u56F2\u3092\u79FB\u52D5\u3057\u3066\u975E\u5E38\u53E3\u3092\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u6D88\u706B\u8A13\u7DF4\u306F\u81EA\u52D5\u7684\u306B\u59CB\u307E\u308A\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040917
    m_Localized: "\u6D88\u706B\u8A13\u7DF4\u3092\u958B\u59CB"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040918
    m_Localized: "\u6D88\u706B\u8A13\u7DF4\u306F\u3042\u3068{0}\u79D2\u3067\u59CB\u307E\u308A\u307E\u3059"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040919
    m_Localized: "\u6D88\u706B\u5668\u3092\u9078\u629E"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040920
    m_Localized: "CO₂消火器は電気火災、粉末消火器はガソリン火災に使用します。1つ選んで確認してください。"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040921
    m_Localized: "CO\u2082"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040922
    m_Localized: "CO\u2082\u6D88\u706B\u5668"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040923
    m_Localized: "電気火災に使用します。\n\n電気を通さず、機器を腐食させません。\n\nこの訓練ではガソリン火災には使用しません。"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040924
    m_Localized: "\u7C89\u672B\u6D88\u706B\u5668"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040925
    m_Localized: "ガソリン火災に使用します。\n\n燃料と空気を遮断する層を作ります。\n\nこの訓練では電気火災には使用しません。"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040926
    m_Localized: "\u8AAC\u660E"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040927
    m_Localized: "\u3059\u3079\u3066\u306E\u706B\u3092\u6D88\u3059"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040928
    m_Localized: "\u5B89\u5168\u30D4\u30F3\u3092\u629C\u304D\u3001\u706B\u5143\u306B\u5411\u3051\u3066\u30EC\u30D0\u30FC\u3092\u63E1\u308A\u3001\u5DE6\u53F3\u306B\u5674\u5C04\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040929
    m_Localized: "\u6B8B\u308A\u6642\u9593: {0}:{1}\n\u5B89\u5168\u30D4\u30F3\u3092\u629C\u304D\u3001\u706B\u5143\u306B\u5411\u3051\u3066\u30EC\u30D0\u30FC\u3092\u63E1\u308A\u3001\u5DE6\u53F3\u306B\u5674\u5C04\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040930
    m_Localized: "\u76F4\u3061\u306B\u907F\u96E3"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040931
    m_Localized: "\u6848\u5185\u8868\u793A\u306B\u5F93\u3044\u3001\u6642\u9593\u5207\u308C\u306B\u306A\u308B\u524D\u306B\u975E\u5E38\u53E3\u3078\u5411\u304B\u3063\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040932
    m_Localized: "\u6642\u9593: \u7121\u5236\u9650\n\u6848\u5185\u8868\u793A\u306B\u5F93\u3063\u3066\u975E\u5E38\u53E3\u3078\u5411\u304B\u3063\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040933
    m_Localized: "\u6B8B\u308A\u6642\u9593: {0}:{1}\n\u6848\u5185\u8868\u793A\u306B\u5F93\u3044\u3001\u6642\u9593\u5207\u308C\u306B\u306A\u308B\u524D\u306B\u975E\u5E38\u53E3\u3078\u5411\u304B\u3063\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040934
    m_Localized: "\u8A13\u7DF4\u5B8C\u4E86"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040935
    m_Localized: "\u3059\u3079\u3066\u306E\u706B\u3092\u6D88\u3057\u3001\u5B89\u5168\u306A\u5834\u6240\u306B\u907F\u96E3\u3067\u304D\u307E\u3057\u305F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040936
    m_Localized: "\u8A13\u7DF4\u5931\u6557"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040937
    m_Localized: "火を消し止めることができませんでした。正しい消火手順で再試行してください。"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040946
    m_Localized: "初期消火活動をとても適切に行いました。体験の完了、おめでとうございます。ありがとうございました！\n\n適切な消火器を選択できました。CO₂消火器は電気を通さず、機器を腐食させないため、電気火災に適しています。"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040947
    m_Localized: "初期消火活動をとても適切に行いました。体験の完了、おめでとうございます。ありがとうございました！\n\n適切な消火器を選択できました。粉末消火剤はガソリン火災に触れると遮断層を作り、燃料と空気の接触を防いで効果的に消火します。"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040948
    m_Localized: "制限時間内に安全な場所へ避難できませんでした。案内表示に従い、速やかに非常口へ向かってください。"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040949
    m_Localized: "制限時間内に消火できませんでした。素早く操作し、ノズルを火元に向けて左右に噴射してください。"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040950
    m_Localized: "消火する前に消火器の薬剤がなくなりました。ノズルを火元に正確に向け、消火剤を効率よく使用してください。"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040951
    m_Localized: "消火する前に非常口へ到達しました。この訓練では、避難する前に火を完全に消してください。"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040952
    m_Localized: "適切な消火器を選択できませんでした。粉末消火器は機器を損傷させることがあり、濃い粉じんで視界を遮り、呼吸を困難にします。電気火災には、電気を通さず機器を腐食させないCO₂消火器を使用してください。"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040953
    m_Localized: "適切な消火器を選択できませんでした。ガソリン火災には粉末消火器を使用してください。屋外の開けた場所や風が強い場所ではCO₂が拡散しやすく、消火効果が低下します。"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040938
    m_Localized: "\u30D2\u30F3\u30C8"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040939
    m_Localized: "2\u672C\u306E\u6D88\u706B\u5668\u304B\u30891\u672C\u3092\u9078\u3093\u3067\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040940
    m_Localized: "\u300C\u78BA\u8A8D\u300D\u3092\u62BC\u3057\u3066\u7D9A\u3051\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040941
    m_Localized: "\u5B89\u5168\u30D4\u30F3\u3092\u629C\u3044\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040942
    m_Localized: "\u706B\u5143\u306B\u5411\u3051\u3066\u30EC\u30D0\u30FC\u3092\u63E1\u3063\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040943
    m_Localized: "\u300C\u975E\u5E38\u53E3\u300D\u306E\u8868\u793A\u306B\u5F93\u3063\u3066\u907F\u96E3\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040944
    m_Localized: "\u8B66\u544A\uFF01\u706B\u304B\u3089\u5B89\u5168\u306A\u8DDD\u96E2\u3092\u4FDD\u3063\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040945
    m_Localized: "\u975E\u5E38\u53E3"
    m_Metadata:
      m_Items: []
  - m_Id: 1448646678781953
    m_Localized: "\u958B\u59CB\u3059\u308B\u524D\u306B\u5B89\u5168\u30D4\u30F3\u3092\u5143\u306B\u623B\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1448646678781952
    m_Localized: "\u74B0\u5883\u3092\u9078\u629E"
    m_Metadata:
      m_Items: []
  - m_Id: 1448646678781954
    m_Localized: "\u30CF\u30A4\u30E9\u30A4\u30C8\u3055\u308C\u305F\u30D6\u30EC\u30FC\u30AB\u30FC\u3078\u79FB\u52D5\u3057\u3001\u96FB\u6E90\u3092\u5207\u3063\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1448646678781955
    m_Localized: "\u30CF\u30A4\u30E9\u30A4\u30C8\u3055\u308C\u305F\u706B\u707D\u5831\u77E5\u5668\u306E\u3044\u305A\u308C\u304B\u3092\u4F5C\u52D5\u3055\u305B\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

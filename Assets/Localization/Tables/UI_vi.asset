  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: UI_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 7c2bb8a07c69bff42b7ab36a83db000c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1303486464
    m_Localized: "N\xFAt"
    m_Metadata:
      m_Items: []
  - m_Id: 1328652288
    m_Localized: "B\u1EAET \u0110\u1EA6U"
    m_Metadata:
      m_Items: []
  - m_Id: 1328652289
    m_Localized: "X\xC1C NH\u1EACN"
    m_Metadata:
      m_Items: []
  - m_Id: 1328652290
    m_Localized: "TI\u1EBEP T\u1EE4C"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040896
    m_Localized: "QUAY L\u1EA0I"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040897
    m_Localized: "TH\u1EEC L\u1EA0I"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040898
    m_Localized: "CH\u01A0I L\u1EA0I"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040900
    m_Localized: "HU\u1EA4N LUY\u1EC6N CH\u1EEEA CH\xC1Y"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040901
    m_Localized: "B\u1EAET \u0110\u1EA6U HU\u1EA4N LUY\u1EC6N"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040902
    m_Localized: "1. Ch\u1ECDn b\xECnh ch\u1EEFa ch\xE1y ph\xF9 h\u1EE3p v\u1EDBi
      \u0111\xE1m ch\xE1y.\n2. R\xFAt ch\u1ED1t an to\xE0n.\n3. H\u01B0\u1EDBng v\xF2i
      phun v\xE0o g\u1ED1c l\u1EEDa.\n4. B\xF3p c\xF2 v\xE0 lia v\xF2i qua l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040903
    m_Localized: "NH\xC0 M\xC1Y"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040904
    m_Localized: "Hu\u1EA5n luy\u1EC7n an to\xE0n ch\xE1y n\u1ED5 trong nh\xE0 m\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040905
    m_Localized: "C\xD4NG VI\xCAN"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040906
    m_Localized: "Hu\u1EA5n luy\u1EC7n an to\xE0n ch\xE1y n\u1ED5 ngo\xE0i tr\u1EDDi"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040907
    m_Localized: "CH\u1ECCN NG\xD4N NG\u1EEE"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040908
    m_Localized: "Ch\u1ECDn ng\xF4n ng\u1EEF anh mu\u1ED1n s\u1EED d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040909
    m_Localized: "Ti\u1EBFng Vi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040910
    m_Localized: English
    m_Metadata:
      m_Items: []
  - m_Id: 1337040911
    m_Localized: "\u65E5\u672C\u8A9E"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040912
    m_Localized: "H\u01AF\u1EDANG D\u1EAAN AN TO\xC0N"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040913
    m_Localized: "1. Kh\xE1m ph\xE1 khu v\u1EF1c v\xE0 x\xE1c \u0111\u1ECBnh l\u1ED1i
      tho\xE1t hi\u1EC3m.\n2. Ch\u1ECDn b\xECnh ch\u1EEFa ch\xE1y ph\xF9 h\u1EE3p
      v\u1EDBi lo\u1EA1i \u0111\xE1m ch\xE1y.\n3. R\xFAt ch\u1ED1t an to\xE0n.\n4.
      H\u01B0\u1EDBng v\xF2i phun v\xE0o g\u1ED1c l\u1EEDa.\n5. B\xF3p c\xF2 v\xE0
      lia v\xF2i qua l\u1EA1i.\n6. Sau khi d\u1EADp l\u1EEDa, \u0111i theo ch\u1EC9
      d\u1EABn \u0111\u1EBFn l\u1ED1i tho\xE1t hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040914
    m_Localized: "Tr\u01B0\u1EDBc khi di\u1EC5n t\u1EADp:\n\n1. Kh\xE1m ph\xE1 khu
      v\u1EF1c v\xE0 x\xE1c \u0111\u1ECBnh l\u1ED1i tho\xE1t hi\u1EC3m.\n\n2. Khi
      c\xF3 ch\xE1y, ch\u1ECDn b\xECnh ch\u1EEFa ch\xE1y ph\xF9 h\u1EE3p v\u1EDBi
      lo\u1EA1i \u0111\xE1m ch\xE1y.\n\n3. R\xFAt ch\u1ED1t an to\xE0n.\n\n4. H\u01B0\u1EDBng
      v\xF2i phun v\xE0o g\u1ED1c l\u1EEDa.\n\n5. B\xF3p c\xF2 v\xE0 lia v\xF2i qua
      l\u1EA1i.\n\n6. Sau khi d\u1EADp l\u1EEDa, d\xF9ng \u0111i\u1EC7n tho\u1EA1i
      kh\u1EA9n c\u1EA5p \u0111\u1EC3 li\xEAn l\u1EA1c GA ho\u1EB7c B\u1EA3o v\u1EC7.\n\n7.
      \u0110i theo ch\u1EC9 d\u1EABn \u0111\u1EBFn l\u1ED1i tho\xE1t hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040915
    m_Localized: "KH\xC1M PH\xC1 KHU V\u1EF0C"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040916
    m_Localized: "Di chuy\u1EC3n quanh khu v\u1EF1c v\xE0 x\xE1c \u0111\u1ECBnh l\u1ED1i
      tho\xE1t hi\u1EC3m.\nBu\u1ED5i di\u1EC5n t\u1EADp s\u1EBD t\u1EF1 \u0111\u1ED9ng
      b\u1EAFt \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040917
    m_Localized: "B\u1EAET \u0110\u1EA6U DI\u1EC4N T\u1EACP"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040918
    m_Localized: "Di\u1EC5n t\u1EADp b\u1EAFt \u0111\u1EA7u sau {0} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040919
    m_Localized: "CH\u1ECCN B\xCCNH CH\u1EEEA CH\xC1Y"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040920
    m_Localized: "CO\u2082 d\xF9ng cho ch\xE1y \u0111i\u1EC7n. B\u1ED9t kh\xF4 d\xF9ng
      cho ch\xE1y x\u0103ng. Ch\u1ECDn m\u1ED9t b\xECnh r\u1ED3i x\xE1c nh\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040921
    m_Localized: "CO\u2082"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040922
    m_Localized: "B\xCCNH CH\u1EEEA CH\xC1Y CO\u2082"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040923
    m_Localized: "D\xF9ng cho \u0111\xE1m ch\xE1y \u0111i\u1EC7n.\n\nKh\xF4ng d\u1EABn
      \u0111i\u1EC7n v\xE0 kh\xF4ng g\xE2y \u0103n m\xF2n thi\u1EBFt b\u1ECB.\n\nTrong
      b\xE0i hu\u1EA5n luy\u1EC7n n\xE0y kh\xF4ng d\xF9ng cho ch\xE1y x\u0103ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040924
    m_Localized: "B\xCCNH CH\u1EEEA CH\xC1Y B\u1ED8T KH\xD4"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040925
    m_Localized: "D\xF9ng cho \u0111\xE1m ch\xE1y x\u0103ng.\n\nT\u1EA1o l\u1EDBp
      c\xE1ch ly, ng\u0103n kh\xF4ng kh\xED ti\u1EBFp x\xFAc v\u1EDBi nhi\xEAn li\u1EC7u.\n\nTrong
      b\xE0i hu\u1EA5n luy\u1EC7n n\xE0y kh\xF4ng d\xF9ng cho ch\xE1y \u0111i\u1EC7n."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040926
    m_Localized: "M\xF4 t\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040927
    m_Localized: "D\u1EACP T\u1EAET T\u1EA4T C\u1EA2 \u0110\xC1M CH\xC1Y"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040928
    m_Localized: "R\xFAt ch\u1ED1t an to\xE0n, h\u01B0\u1EDBng v\xF2i v\xE0o g\u1ED1c
      l\u1EEDa, b\xF3p c\xF2 v\xE0 lia v\xF2i qua l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040929
    m_Localized: "TH\u1EDCI GIAN: {0}:{1}\nR\xFAt ch\u1ED1t an to\xE0n, h\u01B0\u1EDBng
      v\xF2i v\xE0o g\u1ED1c l\u1EEDa, b\xF3p c\xF2 v\xE0 lia v\xF2i qua l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040930
    m_Localized: "S\u01A0 T\xC1N NGAY"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040931
    m_Localized: "\u0110i theo ch\u1EC9 d\u1EABn v\xE0 \u0111\u1EBFn l\u1ED1i tho\xE1t
      hi\u1EC3m tr\u01B0\u1EDBc khi h\u1EBFt gi\u1EDD."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040932
    m_Localized: "TH\u1EDCI GIAN: KH\xD4NG GI\u1EDAI H\u1EA0N\n\u0110i theo ch\u1EC9
      d\u1EABn v\xE0 \u0111\u1EBFn l\u1ED1i tho\xE1t hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040933
    m_Localized: "TH\u1EDCI GIAN: {0}:{1}\n\u0110i theo ch\u1EC9 d\u1EABn v\xE0 \u0111\u1EBFn
      l\u1ED1i tho\xE1t hi\u1EC3m tr\u01B0\u1EDBc khi h\u1EBFt gi\u1EDD."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040934
    m_Localized: "HO\xC0N TH\xC0NH HU\u1EA4N LUY\u1EC6N"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040935
    m_Localized: "T\u1EA5t c\u1EA3 \u0111\xE1m ch\xE1y \u0111\xE3 \u0111\u01B0\u1EE3c
      d\u1EADp v\xE0 b\u1EA1n \u0111\xE3 \u0111\u1EBFn n\u01A1i an to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040936
    m_Localized: "HU\u1EA4N LUY\u1EC6N TH\u1EA4T B\u1EA0I"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040937
    m_Localized: "\u0110\xE1m ch\xE1y ch\u01B0a \u0111\u01B0\u1EE3c d\u1EADp t\u1EAFt.
      H\xE3y th\u1EED l\u1EA1i v\xE0 th\u1EF1c hi\u1EC7n \u0111\xFAng quy tr\xECnh
      d\xF9ng b\xECnh ch\u1EEFa ch\xE1y."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040946
    m_Localized: "B\u1EA1n \u0111\xE3 th\u1EF1c hi\u1EC7n r\u1EA5t t\u1ED1t c\xF4ng
      t\xE1c ch\u1EEFa ch\xE1y c\u01A1 s\u1EDF. Ch\xFAc m\u1EEBng b\u1EA1n \u0111\xE3
      ho\xE0n th\xE0nh tr\u1EA3i nghi\u1EC7m. Xin c\u1EA3m \u01A1n!\n\nB\u1EA1n \u0111\xE3
      ch\u1ECDn \u0111\xFAng lo\u1EA1i b\xECnh ch\u1EEFa ch\xE1y ph\xF9 h\u1EE3p
      v\xEC khi s\u1EED d\u1EE5ng b\xECnh CO\u2082, b\xECnh n\xE0y s\u1EBD kh\xF4ng
      d\u1EABn \u0111i\u1EC7n v\xE0 kh\xF4ng g\xE2y \u0103n m\xF2n thi\u1EBFt b\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040947
    m_Localized: "B\u1EA1n \u0111\xE3 th\u1EF1c hi\u1EC7n r\u1EA5t t\u1ED1t c\xF4ng
      t\xE1c ch\u1EEFa ch\xE1y c\u01A1 s\u1EDF. Ch\xFAc m\u1EEBng b\u1EA1n \u0111\xE3
      ho\xE0n th\xE0nh tr\u1EA3i nghi\u1EC7m. Xin c\u1EA3m \u01A1n!\n\nB\u1EA1n \u0111\xE3
      ch\u1ECDn \u0111\xFAng lo\u1EA1i b\xECnh ch\u1EEFa ch\xE1y ph\xF9 h\u1EE3p
      v\xEC khi ti\u1EBFp x\xFAc v\u1EDBi l\u1EEDa do x\u0103ng g\xE2y n\xEAn s\u1EBD
      t\u1EA1o ra l\u1EDBp m\xE0ng c\xE1ch ly, ng\u0103n kh\xF4ng kh\xED ti\u1EBFp
      x\xFAc v\u1EDBi nhi\xEAn li\u1EC7u v\xE0 d\u1EADp t\u1EAFt l\u1EEDa hi\u1EC7u
      qu\u1EA3."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040948
    m_Localized: "B\u1EA1n ch\u01B0a \u0111\u1EBFn n\u01A1i an to\xE0n trong th\u1EDDi
      gian quy \u0111\u1ECBnh. H\xE3y \u0111i theo ch\u1EC9 d\u1EABn v\xE0 t\u1EDBi
      l\u1ED1i tho\xE1t hi\u1EC3m k\u1ECBp th\u1EDDi."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040949
    m_Localized: "B\u1EA1n ch\u01B0a d\u1EADp t\u1EAFt \u0111\xE1m ch\xE1y trong
      th\u1EDDi gian quy \u0111\u1ECBnh. H\xE3y thao t\xE1c nhanh ch\xF3ng, h\u01B0\u1EDBng
      v\xF2i v\xE0o g\u1ED1c l\u1EEDa v\xE0 lia v\xF2i qua l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040950
    m_Localized: "B\xECnh ch\u1EEFa ch\xE1y \u0111\xE3 h\u1EBFt tr\u01B0\u1EDBc khi
      b\u1EA1n d\u1EADp t\u1EAFt \u0111\u01B0\u1EE3c \u0111\xE1m ch\xE1y. H\xE3y
      h\u01B0\u1EDBng v\xF2i ch\xEDnh x\xE1c v\xE0o g\u1ED1c l\u1EEDa v\xE0 s\u1EED
      d\u1EE5ng ch\u1EA5t ch\u1EEFa ch\xE1y hi\u1EC7u qu\u1EA3 h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040951
    m_Localized: "B\u1EA1n \u0111\xE3 \u0111\u1EBFn l\u1ED1i tho\xE1t hi\u1EC3m khi
      \u0111\xE1m ch\xE1y ch\u01B0a \u0111\u01B0\u1EE3c d\u1EADp t\u1EAFt. Trong
      b\xE0i hu\u1EA5n luy\u1EC7n n\xE0y, b\u1EA1n c\u1EA7n d\u1EADp t\u1EAFt ho\xE0n
      to\xE0n \u0111\xE1m ch\xE1y tr\u01B0\u1EDBc khi tho\xE1t hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040952
    m_Localized: "B\u1EA1n ch\u01B0a ch\u1ECDn \u0111\xFAng lo\u1EA1i b\xECnh ch\u1EEFa
      ch\xE1y ph\xF9 h\u1EE3p v\xEC khi s\u1EED d\u1EE5ng b\xECnh b\u1ED9t s\u1EBD
      g\xE2y h\u01B0 h\u1ECFng thi\u1EBFt b\u1ECB, t\u1EA1o m\xE0n b\u1EE5i d\xE0y
      \u0111\u1EB7c, c\u1EA3n tr\u1EDF t\u1EA7m nh\xECn v\xE0 g\xE2y kh\xF3 th\u1EDF.
      \u0110\u1ED1i v\u1EDBi \u0111\xE1m ch\xE1y \u0111i\u1EC7n, c\u1EA7n s\u1EED
      d\u1EE5ng b\xECnh ch\u1EEFa ch\xE1y CO\u2082 nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040953
    m_Localized: "B\u1EA1n ch\u01B0a ch\u1ECDn \u0111\xFAng lo\u1EA1i b\xECnh ch\u1EEFa
      ch\xE1y ph\xF9 h\u1EE3p. \u0110\u1ED1i v\u1EDBi \u0111\xE1m ch\xE1y x\u0103ng,
      c\u1EA7n s\u1EED d\u1EE5ng b\xECnh ch\u1EEFa ch\xE1y b\u1ED9t nh\xE9 v\xEC
      \u1EDF khu v\u1EF1c b\xEAn ngo\xE0i tr\u1ED1ng tr\u1EA3i ho\u1EB7c c\xF3 gi\xF3
      m\u1EA1nh, CO\u2082 d\u1EC5 b\u1ECB ph\xE2n t\xE1n, l\xE0m gi\u1EA3m hi\u1EC7u
      qu\u1EA3 ch\u1EEFa ch\xE1y."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040938
    m_Localized: "G\u1EE2I \xDD"
    m_Metadata:
      m_Items: []
  - m_Id: 1337040939
    m_Localized: "Ch\u1ECDn 1 trong 2 b\xECnh ch\u1EEFa ch\xE1y."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040940
    m_Localized: "Nh\u1EA5n X\xC1C NH\u1EACN \u0111\u1EC3 ti\u1EBFp t\u1EE5c."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040941
    m_Localized: "R\xFAt ch\u1ED1t an to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040942
    m_Localized: "H\u01B0\u1EDBng v\xF2i v\xE0o g\u1ED1c l\u1EEDa v\xE0 b\xF3p c\xF2."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040943
    m_Localized: "\u0110i theo bi\u1EC3n L\u1ED0I THO\xC1T \u0111\u1EBFn l\u1ED1i
      tho\xE1t hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040944
    m_Localized: "C\u1EA3nh b\xE1o! H\xE3y gi\u1EEF kho\u1EA3ng c\xE1ch an to\xE0n
      v\u1EDBi \u0111\xE1m ch\xE1y."
    m_Metadata:
      m_Items: []
  - m_Id: 1337040945
    m_Localized: "L\u1ED0I THO\xC1T"
    m_Metadata:
      m_Items: []
  - m_Id: 1448646678781953
    m_Localized: "\u0110\u1EB7t l\u1EA1i ch\u1ED1t tr\u01B0\u1EDBc khi b\u1EAFt \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 1448646678781952
    m_Localized: "CH\u1ECCN M\xD4I TR\u01AF\u1EDCNG"
    m_Metadata:
      m_Items: []
  - m_Id: 1448646678781954
    m_Localized: "\u0110i \u0111\u1EBFn c\u1EA7u dao \u0111\u01B0\u1EE3c \u0111\xE1nh
      d\u1EA5u v\xE0 ng\u1EAFt ngu\u1ED3n \u0111i\u1EC7n."
    m_Metadata:
      m_Items: []
  - m_Id: 1448646678781955
    m_Localized: "K\xEDch ho\u1EA1t m\u1ED9t trong c\xE1c n\xFAt b\xE1o ch\xE1y \u0111\u01B0\u1EE3c
      \u0111\xE1nh d\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 10302763491102720
    m_Localized: "\u0110\xC3 THO\xC1T HI\u1EC2M"
    m_Metadata:
      m_Items: []
  - m_Id: 10302763574988800
    m_Localized: "B\u1EA1n \u0111\xE3 tho\xE1t ra an to\xE0n, nh\u01B0ng \u0111\xE1m
      ch\xE1y v\u1EABn ch\u01B0a \u0111\u01B0\u1EE3c d\u1EADp t\u1EAFt."
    m_Metadata:
      m_Items: []
  - m_Id: 10877759133290496

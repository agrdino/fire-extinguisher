    - target: {fileID: 4753628180596766500, guid: 222277ce975d31c42852f4c0920bf6f2, type: 3}
      propertyPath: m_text
      value: FIRE EXTINGUISHER TRAINING
      objectReference: {fileID: 0}
    - target: {fileID: 4753628180596766500, guid: 222277ce975d31c42852f4c0920bf6f2, type: 3}
      propertyPath: m_fontSize
      value: 72
      objectReference: {fileID: 0}
    - target: {fileID: 6524490427946553663, guid: 222277ce975d31c42852f4c0920bf6f2, type: 3}
      propertyPath: m_text
      value: '1. Choose the extinguisher that matches the fire.

        2. Remove
        the safety pin.

        3. Aim at the base of the fire.

        4. Squeeze
        the lever and sweep side to side.

        Extinguish every fire, then follow
        the exit marker.'
      objectReference: {fileID: 0}

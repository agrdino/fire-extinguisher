  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.95, g: 0.95, b: 0.95, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 34
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 18
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.2
  m_Text: 'Before the fire drill:


    1. Explore the area and locate the emergency
    exit.


    2. When a fire appears, choose an extinguisher that matches the fire
    type.


    3. Remove the safety pin.


    4. Aim at the base of the fire.


    5.
    Squeeze the lever and sweep side to side.


    6. After extinguishing the fire,
    follow the exit marker.'
